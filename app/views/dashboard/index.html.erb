<%= turbo_stream_from "tasks" %>

<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">SaaS Task Planner</h1>
      <p class="text-slate-400 mt-1">Vitrine Rails 8: Processamento assíncrono (Sidekiq) e atualizações em tempo real (Turbo Streams)</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 animate-ping"></span>
      <span class="text-sm font-semibold text-emerald-400">Canal Real-time Ativo</span>
    </div>
  </div>

  <!-- Métricas via ViewComponents -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= render(MetricCardComponent.new(
      title: "Total de Tarefas",
      value: @total_tasks,
      icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
      color_class: "bg-indigo-600/30 text-indigo-400 border border-indigo-500/20"
    )) %>

    <%= render(MetricCardComponent.new(
      title: "Tarefas Concluídas",
      value: @completed_tasks,
      icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
      color_class: "bg-emerald-600/30 text-emerald-400 border border-emerald-500/20"
    )) %>

    <%= render(MetricCardComponent.new(
      title: "Tempo Médio",
      value: "#{@avg_time}s",
      icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
      color_class: "bg-amber-600/30 text-amber-400 border border-amber-500/20"
    )) %>
  </div>

  <!-- Grid Principal -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Esquerda: Formulário -->
    <div class="p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-xl h-fit">
      <h2 class="text-xl font-bold text-white mb-4">Nova Tarefa Assíncrona</h2>
      <p class="text-sm text-slate-400 mb-6">Cadastre uma tarefa para que o Sidekiq faça o processamento simulado em background.</p>

      <div id="task_form_container">
        <%= render "tasks/form", task: @new_task %>
      </div>
    </div>

    <!-- Direita: Lista de Tarefas -->
    <div class="lg:col-span-2 p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-xl flex flex-col">
      <h2 class="text-xl font-bold text-white mb-4">Fila de Tarefas</h2>
      
      <div class="overflow-x-auto rounded-xl border border-white/5 bg-black/20">
        <table class="min-w-full divide-y divide-white/5">
          <thead>
            <tr class="bg-white/[0.01]">
              <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Tarefa</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Sumário do Resultado</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-400 uppercase tracking-wider">Tempo</th>
            </tr>
          </thead>
          <tbody id="tasks_table_body" class="divide-y divide-white/5">
            <%= render @tasks %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
